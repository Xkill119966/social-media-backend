{
    "name": "social-media-api",
    "version": "1.0.0",
    "description": "RESTful API for social media platform with authentication, posts, comments, and reactions",
    "main": "dist/server.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "ts-node-dev src/server.ts",
        "migrate": "ts-node src/database/migrate.ts",
        "seed": "ts-node src/database/seed.ts"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-slow-down": "^2.0.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.6.0",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.2",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/multer": "^1.4.7",
        "@types/node": "^20.4.5",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
